###############################################################################
# StatGPT Docker Compose configuration
#
# Copy to .env and fill in environment-specific values and secrets:
#   cp .env.example .env
#
# Keycloak is an external prerequisite. DIAL may be the sibling stack in dial/
# (shared Docker network `statgpt`) or any other reachable DIAL deployment.
#
# Variable names are prefixed per component where values may differ
# (e.g. DIAL API keys, Keycloak clients). docker-compose.yml maps them to the
# container env names expected by each image.
#
# With dial/ on the shared network, use http://core:8080 for DIAL URLs used by
# Compose containers (including Admin/Portal Next.js servers). The local API key
# must match a key in dial/core/config.json (default: statgpt_api_key).
#
# Defaults that use Compose service DNS (pgvector, elasticsearch, core, …) work
# for the bundled stack. Override them if you point at external services instead.
###############################################################################

### Image versions ###
# Aligned with StatGPT Helm Chart 1.14.3
# Backend version is used for both chat-backend and admin-backend (must be the same)
BACKEND_VERSION=0.14.1
# Admin Frontend version
ADMIN_FRONTEND_VERSION=0.5.1
# Portal Frontend version
PORTAL_FRONTEND_VERSION=0.6.3
# SDMX Proxy version is used for both sdmx-proxy and sdmx-proxy-config-server (must be the same)
SDMX_PROXY_VERSION=0.5.0
# MCP App Frontend version
MCP_APP_FRONTEND_VERSION=0.1.0
# Generic RAG version
GENERIC_RAG_VERSION=0.2.0
# PostgreSQL + pgvector image tag (pgvector extension 0.8.1 on PostgreSQL 16)
PGVECTOR_IMAGE_TAG=0.8.1-pg16
# Elasticsearch image tag
ELASTICSEARCH_VERSION=8.14.3


###############################################################################
# chat-backend
###############################################################################
# Name of the DIAL app for OpenTelemetry
CHAT_BACKEND_DIAL_APP_NAME=StatGPT
# Show debug stages in DIAL
CHAT_BACKEND_DIAL_SHOW_DEBUG_STAGES=false
# Show stage seconds in DIAL
CHAT_BACKEND_DIAL_SHOW_STAGE_SECONDS=false
# Number of concurrent web processes
CHAT_BACKEND_WEB_CONCURRENCY=1
# Enable verbose logging for Langchain
CHAT_BACKEND_LANGCHAIN_VERBOSE=false
# Enable debug logging for Langchain
CHAT_BACKEND_LANGCHAIN_DEBUG=false
# Default seed for Langchain operations
CHAT_BACKEND_LANGCHAIN_DEFAULT_SEED=820288

# URL for DIAL application (reachable from Compose containers)
CHAT_BACKEND_DIAL_URL=http://core:8080
# DIAL API key for authentication (must match a key in DIAL Core config)
CHAT_BACKEND_DIAL_API_KEY=statgpt_api_key
# Host for PGVector database
CHAT_BACKEND_PGVECTOR_HOST=pgvector
# Port for PGVector database
CHAT_BACKEND_PGVECTOR_PORT=5432
# Database name for PGVector (defaults to PGVECTOR_DATABASE if unset)
# CHAT_BACKEND_PGVECTOR_DATABASE=statgpt
# PGVector database username (defaults to PGVECTOR_USER if unset)
# CHAT_BACKEND_PGVECTOR_USER=statgpt
# PGVector database password (defaults to PGVECTOR_PASSWORD if unset)
# CHAT_BACKEND_PGVECTOR_PASSWORD=
# Use Azure Managed Identity for PostgreSQL (set to "true" to use MSI instead of PGVECTOR_PASSWORD)
CHAT_BACKEND_PGVECTOR_USE_MSI=false
# MSI scope for Azure PostgreSQL (used when PGVECTOR_USE_MSI is "true")
CHAT_BACKEND_PGVECTOR_MSI_SCOPE=https://ossrdbms-aad.database.windows.net/.default
# MSI token refresh timeout in seconds (used when PGVECTOR_USE_MSI is "true")
CHAT_BACKEND_PGVECTOR_MSI_TOKEN_REFRESH_TIMEOUT=86400
# Connection string for Elasticsearch
CHAT_BACKEND_ELASTIC_CONNECTION_STRING=http://elasticsearch:9200
# Elasticsearch authentication username (defaults to ELASTIC_AUTH_USER if unset)
# CHAT_BACKEND_ELASTIC_AUTH_USER=elastic
# Elasticsearch authentication password (defaults to ELASTIC_AUTH_PASSWORD if unset)
# CHAT_BACKEND_ELASTIC_AUTH_PASSWORD=
# Index for Elasticsearch indicators
CHAT_BACKEND_ELASTIC_INDICATORS_INDEX=statgpt-indicators
# Index for Elasticsearch matching
CHAT_BACKEND_ELASTIC_MATCHING_INDEX=statgpt-matching

### MCP Apps ###
# Public origin for MCP widget assets (must match MCP_APP_FRONTEND_VITE_BASE_URL)
CHAT_BACKEND_MCP_APP_ORIGIN=http://localhost:3002
# Internal base URL for fetching widget HTML (Compose service DNS)
CHAT_BACKEND_MCP_APP_HTML_HOST=http://mcp-app-frontend:8080

### Data Related Variables ###
# Configure these variables based on the data uploaded to the application
# Required for StatGPT channels that use SDMX Proxy
CHAT_BACKEND_SDMX_PROXY_HOST=http://sdmx-proxy:8050


###############################################################################
# admin-backend
###############################################################################
# Application mode for admin settings (APP for the running service; INIT is used by admin-backend-init)
ADMIN_BACKEND_ADMIN_MODE=APP
# Number of concurrent web processes
ADMIN_BACKEND_WEB_CONCURRENCY=1

# Enable or disable OIDC authentication
ADMIN_BACKEND_OIDC_AUTH_ENABLED=true
# URL to fetch OIDC configuration (required if OIDC_AUTH_ENABLED=true)
ADMIN_BACKEND_OIDC_CONFIGURATION_ENDPOINT=environment-specific
# Client ID for OIDC authentication (required if OIDC_AUTH_ENABLED=true)
ADMIN_BACKEND_OIDC_CLIENT_ID=environment-specific
# OIDC issuer URL (required if OIDC_AUTH_ENABLED=true)
ADMIN_BACKEND_OIDC_ISSUER=environment-specific
# Claim used for the username extraction (required if OIDC_AUTH_ENABLED=true)
ADMIN_BACKEND_OIDC_USERNAME_CLAIM=environment-specific
# Claim used to identify user roles (required if OIDC_AUTH_ENABLED=true)
ADMIN_BACKEND_ADMIN_ROLES_CLAIM=environment-specific
# Values within the role claim that signify admin access (required if OIDC_AUTH_ENABLED=true)
ADMIN_BACKEND_ADMIN_ROLES_VALUES=environment-specific
# If "true", the admin portal will check for scopes in the OIDC token
ADMIN_BACKEND_ADMIN_SCOPE_CLAIM_VALIDATION_ENABLED=true
# Name of the access token field (required when scope claim validation is enabled)
ADMIN_BACKEND_ADMIN_SCOPE_CLAIM=environment-specific
# Scope claim value (required when scope claim validation is enabled)
ADMIN_BACKEND_ADMIN_SCOPE_VALUE=environment-specific

# URL for DIAL application (reachable from Compose containers)
ADMIN_BACKEND_DIAL_URL=http://core:8080
# DIAL API key for authentication
ADMIN_BACKEND_DIAL_API_KEY=statgpt_api_key
# Host for PGVector database
ADMIN_BACKEND_PGVECTOR_HOST=pgvector
# Port for PGVector database
ADMIN_BACKEND_PGVECTOR_PORT=5432
# Database name for PGVector (defaults to PGVECTOR_DATABASE if unset)
# ADMIN_BACKEND_PGVECTOR_DATABASE=statgpt
# PGVector database username (defaults to PGVECTOR_USER if unset)
# ADMIN_BACKEND_PGVECTOR_USER=statgpt
# PGVector database password (defaults to PGVECTOR_PASSWORD if unset)
# ADMIN_BACKEND_PGVECTOR_PASSWORD=
# Use Azure Managed Identity for PostgreSQL
ADMIN_BACKEND_PGVECTOR_USE_MSI=false
# MSI scope for Azure PostgreSQL
ADMIN_BACKEND_PGVECTOR_MSI_SCOPE=https://ossrdbms-aad.database.windows.net/.default
# MSI token refresh timeout in seconds
ADMIN_BACKEND_PGVECTOR_MSI_TOKEN_REFRESH_TIMEOUT=86400
# Connection string for Elasticsearch
ADMIN_BACKEND_ELASTIC_CONNECTION_STRING=http://elasticsearch:9200
# Elasticsearch authentication username (defaults to ELASTIC_AUTH_USER if unset)
# ADMIN_BACKEND_ELASTIC_AUTH_USER=elastic
# Elasticsearch authentication password (defaults to ELASTIC_AUTH_PASSWORD if unset)
# ADMIN_BACKEND_ELASTIC_AUTH_PASSWORD=
# Index for Elasticsearch indicators
ADMIN_BACKEND_ELASTIC_INDICATORS_INDEX=statgpt-indicators
# Index for Elasticsearch matching
ADMIN_BACKEND_ELASTIC_MATCHING_INDEX=statgpt-matching

### MCP Apps ###
# Public origin for MCP widget assets (must match MCP_APP_FRONTEND_VITE_BASE_URL)
ADMIN_BACKEND_MCP_APP_ORIGIN=http://localhost:3002
# Internal base URL for fetching widget HTML (Compose service DNS)
ADMIN_BACKEND_MCP_APP_HTML_HOST=http://mcp-app-frontend:8080

### Data Related Variables ###
# Configure these variables based on the data uploaded to the application
# Required for StatGPT channels that use SDMX Proxy
ADMIN_BACKEND_SDMX_PROXY_HOST=http://sdmx-proxy:8050
ADMIN_BACKEND_SDMX_PROXY_CONFIG_SERVER_HOST=http://sdmx-proxy-config-server:8060


###############################################################################
# admin-frontend
###############################################################################
# DIAL API URL (reachable from the Admin container; use http://core:8080 with dial/)
ADMIN_FRONTEND_DIAL_API_URL=http://core:8080
# DIAL API key for authentication
ADMIN_FRONTEND_DIAL_API_KEY=statgpt_api_key
# API URL for admin-backend
ADMIN_FRONTEND_API_URL=http://admin-backend:8000/admin
# URL for NextAuth service, e.g. http://localhost:4100
ADMIN_FRONTEND_AUTH_URL=http://localhost:4100
# Trust the host header from a reverse proxy (set to "false" for local/direct access)
ADMIN_FRONTEND_AUTH_TRUST_HOST=true
# Secret for NextAuth session encryption (generate with: openssl rand -base64 64)
ADMIN_FRONTEND_AUTH_SECRET=

### Keycloak Identity Provider ###
# Client ID for Keycloak
ADMIN_FRONTEND_AUTH_KEYCLOAK_CLIENT_ID=environment-specific
# URL for Keycloak, e.g. https://keycloak.example.com/realms/dial
ADMIN_FRONTEND_AUTH_KEYCLOAK_HOST=environment-specific
# Keycloak client secret
ADMIN_FRONTEND_AUTH_KEYCLOAK_SECRET=

### Azure Identity Provider ###
# Uncomment and configure if using Azure AD instead of Keycloak
# Azure AD Client ID for authentication
# ADMIN_FRONTEND_AUTH_AZURE_AD_CLIENT_ID=
# Azure AD Application Name
# ADMIN_FRONTEND_AUTH_AZURE_AD_NAME=
# Azure Authority URL for authentication
# ADMIN_FRONTEND_AUTH_AZURE_AUTHORITY_URL=
# Azure AD Scopes for authentication
# ADMIN_FRONTEND_AUTH_AZURE_AD_SCOPE=
# Azure AD Tenant ID
# ADMIN_FRONTEND_AUTH_AZURE_AD_TENANT_ID=
# Azure AD client secret
# ADMIN_FRONTEND_AUTH_AZURE_AD_SECRET=


###############################################################################
# pgvector
###############################################################################
# Database name
PGVECTOR_DATABASE=statgpt
# Custom database username (also used as POSTGRES_USER for the container)
PGVECTOR_USER=statgpt
# Password for the custom database user
PGVECTOR_PASSWORD=
# Separate database created on first start for generic-rag (must match GENERIC_RAG_DB_NAME; must not share schema with PGVECTOR_DATABASE)
PGVECTOR_GENERIC_RAG_DATABASE=statgpt_generic_rag


###############################################################################
# elasticsearch
###############################################################################
# Security is disabled in docker-compose.yml (xpack.security.enabled=false)
# Set these when you enable security and pass credentials to the backends
# Password for the "elastic" superuser
# ELASTIC_AUTH_PASSWORD=
# Username used by application components (official built-in user is "elastic")
# ELASTIC_AUTH_USER=elastic


###############################################################################
# portal-frontend
###############################################################################
# DIAL API URL (reachable from the Portal container; use http://core:8080 with dial/)
PORTAL_FRONTEND_DIAL_API_URL=http://core:8080
# DIAL API key for authentication
PORTAL_FRONTEND_DIAL_API_KEY=statgpt_api_key
# DIAL API Version
PORTAL_FRONTEND_DIAL_API_VERSION=2025-04-01-preview
# Default model (must match an applications id in dial/core/config.json / channel name)
PORTAL_FRONTEND_DEFAULT_MODEL=statgpt-sample
# URL for NextAuth service, e.g. http://localhost:4200
PORTAL_FRONTEND_AUTH_URL=http://localhost:4200
# Trust the host header from a reverse proxy (set to "false" for local/direct access)
PORTAL_FRONTEND_AUTH_TRUST_HOST=true
# Enable cross-dataset mode to allow viewing, filtering, and configuring grid views across multiple datasets
PORTAL_FRONTEND_CROSS_DATASET_MODE=false
# Markdown message displayed in the informational banner below the footer (leave empty to hide)
PORTAL_FRONTEND_INFO_BANNER_MESSAGE=
# Secret for NextAuth session encryption (generate with: openssl rand -base64 64)
PORTAL_FRONTEND_AUTH_SECRET=

### Keycloak Identity Provider ###
# Client ID for Keycloak
PORTAL_FRONTEND_AUTH_KEYCLOAK_CLIENT_ID=environment-specific
# URL for Keycloak
PORTAL_FRONTEND_AUTH_KEYCLOAK_HOST=environment-specific
# Keycloak client secret
PORTAL_FRONTEND_AUTH_KEYCLOAK_SECRET=

### Azure Identity Provider ###
# Uncomment and configure if using Azure AD instead of Keycloak
# Azure AD Client ID for authentication
# PORTAL_FRONTEND_AUTH_AZURE_AD_CLIENT_ID=
# Azure AD Application Name
# PORTAL_FRONTEND_AUTH_AZURE_AD_NAME=
# Azure Authority URL for authentication
# PORTAL_FRONTEND_AUTH_AZURE_AUTHORITY_URL=
# Azure AD Scopes for authentication
# PORTAL_FRONTEND_AUTH_AZURE_AD_SCOPE=
# Azure AD Tenant ID
# PORTAL_FRONTEND_AUTH_AZURE_AD_TENANT_ID=
# Azure AD client secret
# PORTAL_FRONTEND_AUTH_AZURE_AD_SECRET=


###############################################################################
# sdmx-proxy
###############################################################################
# SDMX Proxy Registry Type
SDMX_PROXY_SDMXPROXY_REGISTRY_CONFIG_SOURCE_TYPE=CONFIG_SERVER

### if SDMX Proxy Registry Type is CONFIG_SERVER ###
# API URL for sdmx-proxy-config-server
SDMX_PROXY_SDMXPROXY_REGISTRY_CONFIG_SOURCE_CONFIGSERVER_URL=http://sdmx-proxy-config-server:8060
# Poll interval for config server updates (ISO-8601 duration format)
SDMX_PROXY_SDMXPROXY_REGISTRY_CONFIG_SOURCE_CONFIGSERVER_POLLINTERVAL=PT180S

### if SDMX Proxy Registry Type is DIAL_STORAGE ###
# DIAL API URL
# SDMX_PROXY_SDMXPROXY_REGISTRY_CONFIG_SOURCE_DIALSTORAGE_BASEURL=environment-specific
# SDMX Proxy Registry Config Filename
# SDMX_PROXY_SDMXPROXY_REGISTRY_CONFIG_SOURCE_FILENAME=environment-specific
# DIAL API key for DIAL Storage
# SDMX_PROXY_SDMXPROXY_REGISTRY_CONFIG_SOURCE_DIALSTORAGE_APIKEY=


###############################################################################
# sdmx-proxy-config-server
###############################################################################
# Config Server Source Type
SDMX_PROXY_CONFIG_SERVER_CONFIG_SERVER_SOURCE_TYPE=DIAL_STORAGE

### if Config Server Source Type is DIAL_STORAGE ###
# Config Server Source Config Path
SDMX_PROXY_CONFIG_SERVER_CONFIG_SERVER_SOURCE_CONFIG_PATH=sdmx-proxy/sdmx_registries_config.json
# Force overwrite of stored DIAL Storage config from the bundled default on startup
SDMX_PROXY_CONFIG_SERVER_CONFIG_SERVER_FORCE_SEED=false
# DIAL API URL (reachable from Compose containers)
SDMX_PROXY_CONFIG_SERVER_DIAL_STORAGE_BASE_URL=http://core:8080
# DIAL API key for DIAL Storage
SDMX_PROXY_CONFIG_SERVER_DIAL_STORAGE_API_KEY=statgpt_api_key


###############################################################################
# mcp-app-frontend
###############################################################################
# Public origin for widget assets (must match CHAT_BACKEND_MCP_APP_ORIGIN / ADMIN_BACKEND_MCP_APP_ORIGIN)
MCP_APP_FRONTEND_VITE_BASE_URL=http://localhost:3002


###############################################################################
# generic-rag
###############################################################################
# Report debug stages in the DIAL conversation
GENERIC_RAG_ENABLE_DEBUG_STAGES=false
# Enable the in-memory file cache
GENERIC_RAG_IN_MEMORY_CACHE_ENABLED=true
# Capacity of the in-memory file cache (e.g. "128MiB", "1GiB")
GENERIC_RAG_IN_MEMORY_CACHE_CAPACITY=128MiB

# URL for DIAL application (reachable from Compose containers)
GENERIC_RAG_DIAL_URL=http://core:8080
# URL where DIAL Core is publicly reachable (used to generate interactive documentation)
GENERIC_RAG_DIAL_PUBLIC_URL=http://localhost:8080
# DIAL API key, enabling background job execution (e.g. indexing) on its behalf
GENERIC_RAG_DIAL_API_KEY=statgpt_api_key

# Host of the PostgreSQL database (requires the pgvector extension)
GENERIC_RAG_DB_HOST=pgvector
# Port of the PostgreSQL database
GENERIC_RAG_DB_PORT=5432
# Name of the PostgreSQL database (must match PGVECTOR_GENERIC_RAG_DATABASE; must not share schema with PGVECTOR_DATABASE)
GENERIC_RAG_DB_NAME=statgpt_generic_rag
# PostgreSQL username (defaults to PGVECTOR_USER if unset)
# GENERIC_RAG_DB_USERNAME=statgpt
# PostgreSQL password (defaults to PGVECTOR_PASSWORD if unset)
# GENERIC_RAG_DB_PASSWORD=
# Use Azure Managed Identity for PostgreSQL
GENERIC_RAG_DB_MSI_ENABLED=false

# Elasticsearch URL (optional; when unset, every ELASTICSEARCH_* value is ignored)
GENERIC_RAG_ELASTICSEARCH_URL=http://elasticsearch:9200
# Elasticsearch authentication username (defaults to ELASTIC_AUTH_USER if unset)
# GENERIC_RAG_ELASTICSEARCH_USERNAME=elastic
# Elasticsearch authentication password (defaults to ELASTIC_AUTH_PASSWORD if unset)
# GENERIC_RAG_ELASTICSEARCH_PASSWORD=
# Prefix added to every index generic-rag creates in Elasticsearch
GENERIC_RAG_ELASTICSEARCH_INDEX_PREFIX=generic-rag-
