###############################################################################
# Minimal local DIAL (Core + Redis + dial-to-dial adapter + Chat 1.x + Themes)
#
# Copy to .env and fill in remote DIAL access and Chat auth:
#   cp .env.example .env
#
# Then generate core/config.json from the example (substitutes REMOTE_DIAL_*):
#   ./generate-config.sh
#
# The local API key in core/config.json (default: statgpt_api_key) must match
# StatGPT *_DIAL_API_KEY values in the parent ../.env.
#
# Image versions: Core / adapter / themes match DIAL Helm Chart 7.2.0.
# Chat uses the new generation (1.x), not the legacy 0.49.x Helm default.
###############################################################################

### Image versions ###
DIAL_CORE_VERSION=0.47.0
DIAL_ADAPTER_DIAL_VERSION=0.18.0
DIAL_CHAT_THEMES_VERSION=0.19.1
# New generation DIAL Chat (SPA + NestJS BFF). Helm 7.2.0 still lists 0.49.0.
DIAL_CHAT_VERSION=1.0.15
REDIS_IMAGE_TAG=8.2.1-alpine3.22

### Remote DIAL (models are proxied via adapter-dial) ###
# Base URL of the remote DIAL Core (no trailing slash), e.g. https://dial.example.com
REMOTE_DIAL_URL=
# API key on the remote DIAL with access to gpt-4.1-2025-04-14, gpt-5.4-2026-03-05, gpt-5.6-terra-2026-07-09, and text-embedding-3-large
REMOTE_DIAL_API_KEY=


###############################################################################
# chat (new generation)
###############################################################################
# Public origin (must match the host port mapping 5000:5000)
CHAT_CORS_ORIGIN=http://localhost:5000
# DIAL Core URL reachable from the chat container
CHAT_DIAL_CORE_URL=http://core:8080
# DIAL API version
CHAT_DIAL_API_VERSION=2025-04-01-preview
# DIAL API key (must match a key in core/config.json)
CHAT_DIAL_API_KEY=statgpt_api_key
# Themes service URL (Compose service DNS)
CHAT_THEMES_CONFIG_URL=http://themes:8080
# Default deployment id (must match an applications id in core/config.json)
CHAT_DEFAULT_DEPLOYMENT=statgpt-sample

# Session encryption key (64 hex characters): openssl rand -hex 32
CHAT_AUTH_SESSION_SECRET=
# Public API base URL used for OIDC redirect URIs
CHAT_AUTH_CALLBACK_BASE_URL=http://localhost:5000
# Post-logout redirect URI (application origin; register in the IdP allowlist)
CHAT_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5000
# Set to "false" for local HTTP; use "true" behind HTTPS
CHAT_AUTH_COOKIE_SECURE=false

### Keycloak Identity Provider ###
# Register redirect URI: {CHAT_AUTH_CALLBACK_BASE_URL}/api/v1/auth/callback/keycloak
# Leave unset to boot Chat without login providers; set all three to enable Keycloak
# CHAT_AUTH_KEYCLOAK_CLIENT_ID=
# CHAT_AUTH_KEYCLOAK_SECRET=
# Bare host with realm path, or full URL, e.g. http://keycloak:8080/realms/dial
# CHAT_AUTH_KEYCLOAK_HOST=

### Azure Identity Provider ###
# Uncomment and configure if using Azure AD instead of Keycloak
# CHAT_AUTH_AZURE_AD_CLIENT_ID=
# CHAT_AUTH_AZURE_AD_SECRET=
# CHAT_AUTH_AZURE_AD_TENANT_ID=
